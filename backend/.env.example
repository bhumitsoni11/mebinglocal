# ============================================================
# MEBINGLOCAL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_placeholder_key
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Upstash Redis (Cache & Rate Limiting)
UPSTASH_REDIS_REST_URL=https://placeholder-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder_token

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# OpenAI (AI Concierge & Itinerary Generator)
OPENAI_API_KEY=sk-proj-placeholder_openai_key

# Google Maps Platform
GOOGLE_MAPS_API_KEY=AIzaSyPlaceholder_GoogleMaps_Key

# Razorpay (Payments & Webhooks)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Resend (Transactional Email)
RESEND_API_KEY=re_placeholder_resend_key
RESEND_FROM_EMAIL=concierge@mebinglocal.com

# PostHog Analytics
POSTHOG_API_KEY=phc_placeholder_posthog_key
POSTHOG_HOST=https://us.i.posthog.com
