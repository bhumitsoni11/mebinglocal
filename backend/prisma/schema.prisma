generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TRAVELER
  LOCAL_FRIEND
  ADMIN
  MODERATOR
  SUPPORT
  SUPER_ADMIN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  FAILED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  LOCAL
  EXPERIENCE
  REVIEW
  MESSAGE
}

enum SavedItemType {
  LOCAL_FRIEND
  EXPERIENCE
  DESTINATION
  PULSE_SPOT
}

model User {
  id               String           @id @default(uuid())
  clerkUserId      String           @unique
  email            String           @unique
  name             String?
  avatar           String?
  role             UserRole         @default(TRAVELER)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  travelerProfile   TravelerProfile?
  localProfile      LocalProfile?
  reviewsAuthored   Review[]                  @relation("AuthorReviews")
  bookingsAsTraveler Booking[]                @relation("TravelerBookings")
  savedItems        SavedItem[]
  chatParticipants  ConversationParticipant[]
  messagesSent      Message[]
  notifications     Notification[]
  auditLogs         AuditLog[]                @relation("AdminAuditLogs")
  reportsSubmitted  Report[]                  @relation("ReporterUser")
  aiConversations   AIConversation[]
  itineraries       Itinerary[]

  @@index([clerkUserId])
  @@index([email])
  @@index([role])
}

model TravelerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  languages      String[] @default([])
  interests      String[] @default([])
  travelStyle    String?
  budgetRange    String?
  homeCountry    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LocalProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagline            String?
  bio                String?
  city               String
  country            String
  destinationId      String?
  destination        Destination?       @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  latitude           Float?
  longitude          Float?
  hourlyRate         Decimal            @default(35.00) @db.Decimal(10, 2)
  currency           String             @default("USD")
  languages          String[]           @default([])
  interests          String[]           @default([])
  expertise          String[]           @default([])
  yearsResident      Int                @default(1)
  responseTimeMin    Int                @default(15)
  responseRatePct    Int                @default(100)
  ratingScore        Float              @default(5.0)
  reviewCount        Int                @default(0)
  isSuperhost        Boolean            @default(false)
  verificationStatus VerificationStatus @default(DRAFT)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  experiences            Experience[]
  availabilitySlots      AvailabilitySlot[]
  bookingsReceived       Booking[]               @relation("LocalFriendBookings")
  reviewsReceived        Review[]                @relation("TargetLocalReviews")
  pulsePosts             PulsePost[]
  verificationApplication VerificationApplication?

  @@index([city, country])
  @@index([verificationStatus])
  @@index([ratingScore])
  @@index([destinationId])
}

model Destination {
  id          String   @id @default(uuid())
  slug        String   @unique
  city        String
  country     String
  region      String?
  heroImage   String
  description String?
  latitude    Float
  longitude   Float
  weatherNote String?
  avgPrice    Decimal? @db.Decimal(10, 2)
  isTrending  Boolean  @default(false)
  localCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locals      LocalProfile[]
  experiences Experience[]
  pulsePosts  PulsePost[]

  @@index([slug])
  @@index([city, country])
  @@index([isTrending])
}

model Experience {
  id             String           @id @default(uuid())
  localProfileId String
  localProfile   LocalProfile     @relation(fields: [localProfileId], references: [id], onDelete: Cascade)
  destinationId  String?
  destination    Destination?     @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  title          String
  description    String
  category       String
  durationHours  Float            @default(3.0)
  maxGuests      Int              @default(4)
  pricePerPerson Decimal          @db.Decimal(10, 2)
  currency       String           @default("USD")
  meetingPoint   String
  inclusions     String[]         @default([])
  requirements   String[]         @default([])
  languages      String[]         @default([])
  status         ExperienceStatus @default(PUBLISHED)
  isInstantBook  Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  ratingScore    Float            @default(5.0)
  reviewCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  images   ExperienceImage[]
  bookings Booking[]
  reviews  Review[]

  @@index([localProfileId])
  @@index([destinationId])
  @@index([category])
  @@index([status])
  @@index([isFeatured])
}

model ExperienceImage {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([experienceId])
}

model AvailabilitySlot {
  id             String       @id @default(uuid())
  localProfileId String
  localProfile   LocalProfile @relation(fields: [localProfileId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  startTime      String
  endTime        String
  isBlocked      Boolean      @default(false)
  maxCapacity    Int          @default(4)
  currentBooked  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([localProfileId, date, startTime])
  @@index([localProfileId, date])
}

model Booking {
  id             String        @id @default(uuid())
  bookingNumber  String        @unique
  travelerUserId String
  traveler       User          @relation("TravelerBookings", fields: [travelerUserId], references: [id], onDelete: Restrict)
  localProfileId String
  localProfile   LocalProfile  @relation("LocalFriendBookings", fields: [localProfileId], references: [id], onDelete: Restrict)
  experienceId   String?
  experience     Experience?   @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  bookingDate    DateTime      @db.Date
  startTime      String
  endTime        String?
  guestCount     Int           @default(1)
  specialNotes   String?
  totalAmount    Decimal       @db.Decimal(10, 2)
  platformFee    Decimal       @default(0.00) @db.Decimal(10, 2)
  hostPayout     Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD")
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payment        Payment?
  review         Review?
  conversation   Conversation?

  @@index([travelerUserId])
  @@index([localProfileId])
  @@index([experienceId])
  @@index([status])
  @@index([bookingDate])
}

model Payment {
  id                 String        @id @default(uuid())
  bookingId          String        @unique
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId    String        @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("USD")
  status             PaymentStatus @default(CREATED)
  paymentMethod      String?
  webhookPayload     Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([razorpayOrderId])
  @@index([status])
}

model Review {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorUserId   String
  author         User          @relation("AuthorReviews", fields: [authorUserId], references: [id], onDelete: Cascade)
  localProfileId String
  localProfile   LocalProfile  @relation("TargetLocalReviews", fields: [localProfileId], references: [id], onDelete: Cascade)
  experienceId   String?
  experience     Experience?   @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  rating         Int           @default(5)
  content        String
  hostReply      String?
  hostRepliedAt  DateTime?
  isVerified     Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([localProfileId])
  @@index([experienceId])
  @@index([authorUserId])
}

model SavedItem {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType   SavedItemType
  targetId   String
  createdAt  DateTime      @default(now())

  @@unique([userId, itemType, targetId])
  @@index([userId])
}

model PulsePost {
  id             String       @id @default(uuid())
  localProfileId String
  localProfile   LocalProfile @relation(fields: [localProfileId], references: [id], onDelete: Cascade)
  destinationId  String
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  title          String
  content        String
  vibeCategory   String
  spotName       String?
  spotAddress    String?
  latitude       Float?
  longitude      Float?
  imageUrl       String?
  upvotesCount   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([destinationId])
  @@index([vibeCategory])
  @@index([createdAt])
}

model Conversation {
  id           String    @id @default(uuid())
  bookingId    String?   @unique
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime @default(now())
  createdAt    DateTime  @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  content        String
  mediaUrl       String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model VerificationApplication {
  id             String             @id @default(uuid())
  localProfileId String             @unique
  localProfile   LocalProfile       @relation(fields: [localProfileId], references: [id], onDelete: Cascade)
  status         VerificationStatus @default(SUBMITTED)
  adminNotes     String?
  idDocType      String?
  residentDocType String?
  automatedChecks Json?
  riskScore      Float?             @default(0.0)
  reviewedBy     String?
  reviewedAt     DateTime?
  submittedAt    DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  documents VerificationDocument[]

  @@index([status])
}

model VerificationDocument {
  id            String                  @id @default(uuid())
  applicationId String
  application   VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  String
  fileUrl       String
  isVerified    Boolean                 @default(false)
  uploadedAt    DateTime                @default(now())

  @@index([applicationId])
}

model Report {
  id             String           @id @default(uuid())
  reporterUserId String
  reporter       User             @relation("ReporterUser", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reason         String
  details        String?
  status         ReportStatus     @default(PENDING)
  resolvedBy     String?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AdminAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AIConversation {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String
  destination String?
  preferences Json?
  result      Json?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Itinerary {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  destination    String
  durationDays   Int
  travelStyle    String?
  budgetEstimate String?
  matchScore     Float?   @default(98.0)
  isSaved        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  days ItineraryDay[]

  @@index([userId])
}

model ItineraryDay {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  themeTitle  String?
  dateLabel   String?

  activities ItineraryActivity[]

  @@index([itineraryId, dayNumber])
}

model ItineraryActivity {
  id             String       @id @default(uuid())
  dayId          String
  day            ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  timeSlot       String
  title          String
  description    String
  neighborhood   String?
  matchedLocalId String?
  activityOrder  Int          @default(0)

  @@index([dayId, activityOrder])
}
